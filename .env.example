# Which backend prompt_lab.py / run_skill.py / agent.py should call.
# mock      -> no network, replays canned outputs (default; safe for demos)
# anthropic -> needs ANTHROPIC_API_KEY
# openai    -> needs OPENAI_API_KEY
# azure     -> needs AZURE_OPENAI_API_KEY, AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_DEPLOYMENT
LLM_PROVIDER=mock
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
